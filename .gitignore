# Stray transpiler output beside TypeScript sources: tsc writes to lib/, so a
# .js next to a .ts in src/ is an accident (a loader resolving .ts by default
# emits one). No such file is tracked.
/vendor/*/src/**/*.js
/packages/*/*/src/**/*.js
